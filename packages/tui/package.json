{
  "name": "kankaku-tui",
  "version": "0.12.0",
  "description": "Terminal app that shows today's kankaku work across every project on disk",
  "license": "MIT",
  "type": "module",
  "bin": {
    "kankaku": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup.mjs --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run build && npm run typecheck && npm test",
    "dev": "tsx src/cli.tsx",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "kankaku": "^0.12.0",
    "kankaku-claude": "^0.12.0",
    "kankaku-hub": "^0.2.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "ink-testing-library": "^4",
    "tsx": "^4",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soyunninja/kankaku.git",
    "directory": "packages/tui"
  }
}
