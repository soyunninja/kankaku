{
  "name": "kankaku",
  "version": "1.0.0",
  "description": "Terminal app that shows today's kankaku work across every project on disk",
  "keywords": [
    "pi-package",
    "kankaku",
    "time-tracking",
    "agents"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "kankaku": "dist/cli.js"
  },
  "files": [
    "dist/",
    "vendor/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./vendor/kankaku-pi/src/extension.ts"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup.mjs --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run build && npm run typecheck && npm test",
    "dev": "tsx src/cli.tsx",
    "prepublishOnly": "npm run check",
    "prepack": "node scripts/vendor-pi.mjs"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "kankaku-pi": "^1.0.0",
    "kankaku-claude": "^1.0.0",
    "kankaku-hub": "^0.2.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "ink-testing-library": "^4",
    "tsx": "^4",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soyunninja/kankaku.git",
    "directory": "packages/cli"
  }
}
