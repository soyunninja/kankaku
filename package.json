{
  "name": "kankaku",
  "version": "0.4.2",
  "description": "pi extension that records agent work time per prompt, excluding waits for the user, with subagent linkage and task/session views",
  "license": "MIT",
  "author": "soyunninja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soyunninja/kankaku.git"
  },
  "homepage": "https://github.com/soyunninja/kankaku#readme",
  "bugs": {
    "url": "https://github.com/soyunninja/kankaku/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "time-tracking",
    "agents"
  ],
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^24.13.4",
    "typescript": "^5.7.0"
  }
}
